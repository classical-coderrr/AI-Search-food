# 复制为 .env 后填写。不要把真实 .env 提交到 Git。
MYSQL_DATABASE=ai_smart_recipe
MYSQL_USER=recipe_app
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=
AGENT_STATE_STORE=redis
AGENT_RECOVERY_ENABLED=true
AGENT_RECOVERY_SCAN_DELAY=PT30S
AGENT_RECOVERY_STALE_AFTER=PT5M
AGENT_RECOVERY_LEASE_DURATION=PT10M

# 至少 32 字节的随机字符串
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 管理后台保存的文本菜谱配置会同步到以下变量（API Key 默认留空，首次使用时在管理后台配置）
AI_TEXT_RECIPE_PROVIDER=qwen
AI_TEXT_RECIPE_PROTOCOL=openai
AI_TEXT_RECIPE_MODEL=qwen-plus
AI_TEXT_RECIPE_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEXT_RECIPE_API_KEY=

# Docker 生产模式固定使用阿里云号码认证服务（PNVS）
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
ALIYUN_PNVS_SIGN_NAME=replace-with-your-pnvs-sign-name
ALIYUN_PNVS_TEMPLATE_CODE=replace-with-your-pnvs-template-code
ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
# 可选：方案名称
ALIYUN_PNVS_SCHEME_NAME=

SMS_CODE_EXPIRY=5m
SMS_RESEND_INTERVAL=60s
SMS_MAX_ATTEMPTS=5
PNVS_CONNECT_TIMEOUT=5s
PNVS_READ_TIMEOUT=10s

# 前端宿主机端口，默认 80；端口被占用时改为 8080 等
FRONTEND_PORT=80
# 仅调试 Compose 时使用 docker-compose.debug.yml
BACKEND_DEBUG_PORT=7068
